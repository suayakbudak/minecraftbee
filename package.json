{
  "name": "bee-animation-app",
  "version": "1.0.0",
  "author": "Suay Akbudak",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64",
    "clean": "rm -rf dist/ && rm -rf node_modules/"
  },
  "build": {
    "appId": "com.beeanimation.app",
    "asar": true,
    "win": {
      "target": "nsis",
      "icon": "bee.ico"
    },
    "directories": {
      "output": "dist"
    }
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  }
}
